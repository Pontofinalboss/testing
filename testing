					TextColor3 = active and Theme.Text or Theme.SubText,
					BackgroundTransparency = active and 0 or 0.2,
				}, 0.2)
			end
		end)
		if first then
			pages[name].Visible = true
			btn.TextColor3 = Theme.Text
			btn.BackgroundTransparency = 0
			first = false
		end
	end
end)


buildEggMap = function()
	-- limpa listas
	for _, c in ipairs(mapList:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
	for _, c in ipairs(areaBar:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end

	local root = getRoot()
	local rootPos = root and root.Position or Vector3.zero

	-- agrupa por área
	local groups, order = {}, {}
	for _, rec in ipairs(EggCache) do
		if rec.obj.Parent then
			if not groups[rec.area] then
				groups[rec.area] = {}
				table.insert(order, rec.area)
			end
			table.insert(groups[rec.area], rec)
		end
	end
	table.sort(order)

	mapCount.Text = #EggCache .. " ovos em " .. #order .. " área(s)"

	-- filtro por área
	local function applyFilter(area)
		for _, row in ipairs(mapList:GetChildren()) do
			if row:IsA("TextButton") then
				row.Visible = (area == nil) or (row:GetAttribute("Area") == area)
			end
		end
	end

	local areaButtons = {}
	local function mkArea(text, area)
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(math.max(70, #text * 8), 30)
		b.BackgroundColor3 = Theme.Panel
		b.BackgroundTransparency = 0.25
		b.AutoButtonColor = false
		b.Font = Enum.Font.GothamSemibold
		b.Text = text
		b.TextSize = 11
		b.TextColor3 = Theme.SubText
		b.Parent = areaBar
		Round(b, 10)
		Stroke(b, Theme.Stroke, 0.7, 1)
		areaButtons[#areaButtons+1] = b

		b.MouseButton1Click:Connect(function()
			for _, other in ipairs(areaButtons) do
				local active = (other == b)
				Tween(other, {
					TextColor3 = active and Theme.Text or Theme.SubText,
					BackgroundTransparency = active and 0 or 0.25,
				}, 0.15)
				Stroke(other, active and Theme.Accent or Theme.Stroke, active and 0 or 0.7, 1)
			end
			applyFilter(area)
		end)
		return b
	end

	local allBtn = mkArea("Tudo", nil)
	allBtn.TextColor3 = Theme.Text
	allBtn.BackgroundTransparency = 0
	Stroke(allBtn, Theme.Accent, 0, 1)

	for _, area in ipairs(order) do
		mkArea(area, area)
	end
	areaBar.CanvasSize = UDim2.new(0, areaLayout.AbsoluteContentSize.X + 8, 0, 0)

	-- linhas de ovos
	local rowOrder = 0
	for _, area in ipairs(order) do
		for _, rec in ipairs(groups[area]) do
			rowOrder += 1
			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, -4, 0, 42)
			row.BackgroundColor3 = Theme.Panel
			row.BackgroundTransparency = 0.25
			row.AutoButtonColor = false
			row.Text = ""
			row.LayoutOrder = rowOrder
			row:SetAttribute("Area", area)
			row.Parent = mapList
			Round(row, 10)
			Stroke(row, Theme.Stroke, 0.75, 1)

			local stripe = Instance.new("Frame")
			stripe.Size = UDim2.fromOffset(4, 24)
			stripe.Position = UDim2.new(0, 6, 0.5, -12)
			stripe.BackgroundColor3 = RARITY_COLORS[math.clamp(rec.rarity, 1, 10)]
			stripe.Parent = row
			Round(stripe, 100)

			Label(row, rec.name, UDim2.new(1, -120, 0, 16), Theme.Text, true, UDim2.new(0, 18, 0, 6)).TextSize = 12
			Label(row, area .. "  •  " .. fmtDist((rec.part.Position - rootPos).Magnitude), UDim2.new(1, -120, 0, 14), Theme.SubText, false, UDim2.new(0, 18, 0, 23)).TextSize = 10

			local score = Label(row, tostring(rec.score), UDim2.fromOffset(70, 16), Theme.Accent2, true, UDim2.new(1, -80, 0, 13))
			score.TextXAlignment = Enum.TextXAlignment.Right
			score.TextSize = 11

			row.MouseEnter:Connect(function() Tween(row, {BackgroundTransparency = 0.1}, 0.12) end)
			row.MouseLeave:Connect(function() Tween(row, {BackgroundTransparency = 0.25}, 0.12) end)
			row.MouseButton1Click:Connect(function()
				flyToEgg(rec)
				notify("Voando até: " .. rec.name, Theme.Success)
			end)
		end
	end
end


	local n = name:lower()
	for _, bad in ipairs(BLACKLIST) do
		if n:find(bad, 1, true) then return true end
	end
	return false
end

local function getEggPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function isInEggFolder(obj)
	for _, folder in ipairs(EGG_FOLDERS) do
		if folder and obj:IsDescendantOf(folder) then return true end
	end
	return false
end

local function hasEggWord(n)
	return (n:find("egg", 1, true) or n:find("ovo", 1, true)) and true or false
end

local function isEgg(obj)
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end

	local n = obj.Name:lower()
	if not hasEggWord(n) then return false end
	if nameBlacklisted(n) then return false end

	local part = getEggPart(obj)
	if not part then return false end
	if part.Size.Magnitude > MAX_EGG_SIZE then return false end

	local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
	local hasTouch  = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil

	return isInEggFolder(obj) or hasPrompt or hasTouch
end

-- modos de mira
local function matchesMode(obj, mode)
	local n = obj.Name:lower()
	if mode == "best" or mode == "all" then return true end
	if mode == "sakura" then
		return n:find("sakura", 1, true) and hasEggWord(n)
	end
	if mode == "angels" then
		local key = (n:find("angel", 1, true) or n:find("anjo", 1, true)
			or n:find("demon", 1, true) or n:find("demônio", 1, true)
			or n:find("demonio", 1, true) or n:find("light", 1, true)
			or n:find("dark", 1, true))
		return key and hasEggWord(n)
	end
	return true
end

local function eggScore(inst)
	local part = getEggPart(inst)
	if not part then return nil end

	local value, rarity
	for _, key in ipairs({"Value","EggValue","Price","Coins","Money","DayValue","Income","MoneyPerSecond","MPS","Reward"}) do
		local v = inst:GetAttribute(key)
		if typeof(v) == "number" then value = v break end
	end

	local r = inst:GetAttribute("Rarity") or inst:GetAttribute("Tier")
	if typeof(r) == "number" then
		rarity = r
	elseif typeof(r) == "string" then
		rarity = RARITY[r:lower()] or 0
	end

	if not rarity then
		local n = inst.Name:lower()
		for key, val in pairs(RARITY) do
			if n:find(key, 1, true) then rarity = val break end
		end
	end

	return (value or 0) * 10 + (rarity or 0) * 1000, part.Position
end

function findBestEgg()
	local mode = State.Mode
	local best, bestScore, bestPos = nil, -1, nil

	for _, obj in ipairs(workspace:GetDescendants()) do
		if isEgg(obj) and matchesMode(obj, mode) then
			local score, pos = eggScore(obj)
			if score then
				local root = getRoot()
				local dist = root and (pos - root.Position).Magnitude or 0

				-- no modo "all" o mais perto ganha; nos outros, o mais valioso
				local finalScore = (mode == "all") and (-dist) or score

				if finalScore > bestScore then
					best, bestScore, bestPos = obj, finalScore, pos
				end
			end
		end
	end

	State.LastScore = (best and select(1, eggScore(best))) or 0
	return best, bestPos
end

local function getRoot()
	local char = Player.Character or Player.CharacterAdded:Wait()
	return char:FindFirstChild("HumanoidRootPart"), char
end

--// ============ INSTANT INTERACT (v3) ================== //
-- Expande o alcance, remove a exigência de linha de visão e zera o
-- HoldDuration antes de disparar o prompt (é isso que faz funcionar).
local function firePrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	pcall(function()
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 250)
		prompt.RequiresLineOfSight = false
		local oldHold = prompt.HoldDuration
		if State.InstantInt then
			prompt.HoldDuration = 0
		end
		prompt:InputHoldBegin()
		task.wait(State.InstantInt and 0.02 or math.max(oldHold, 0.05))
		prompt:InputHoldEnd()
		prompt.HoldDuration = oldHold
	end)
	return true
end

-- Interage com todos os prompts de um objeto
function interactObject(obj)
	local count = 0
	if obj:IsA("ProximityPrompt") then
		if firePrompt(obj) then count += 1 end
	end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			if firePrompt(d) then count += 1 end
		end
	end
	return count
end

-- Interage com tudo que estiver perto (incubadora, shrine, ovos...)
function interactNearby(pos, radius)
	local count = 0
	local seen = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local holder = d:FindFirstAncestorWhichIsA("BasePart", true) or d.Parent
			local part = holder and (holder:IsA("BasePart") and holder or holder:FindFirstChildWhichIsA("BasePart", true))
			if part and (part.Position - pos).Magnitude <= radius and not seen[part] then
				seen[part] = true
				if firePrompt(d) then count += 1 end
			end
		end
	end
	return count
end

--// ================ COLETA REAL ======================== //
function collectEgg(egg)
	-- 1) Remote do seu jogo (caminho mais limpo)
	if PICKUP_REMOTE then
		PICKUP_REMOTE:FireServer(egg)
		return true
	end

	-- 2) Instant Interact em qualquer prompt dentro do ovo
	local prompts = {}
	for _, d in ipairs(egg:GetDescendants()) do
		if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
	end
	if egg:IsA("ProximityPrompt") then table.insert(prompts, egg) end

	if #prompts > 0 then
		for _, p in ipairs(prompts) do
			firePrompt(p)
		end
		return true
	end

	-- 3) Gatilho por toque: encosta o personagem no ovo
	local part = getEggPart(egg)
	local root = getRoot()
	if part and root then
		root.CFrame = CFrame.new(part.Position + Vector3.new(0, (part.Size.Y / 2) + 2.5, 0))
		task.wait(0.25)
		return true
	end

	return false
end

--// ============ BASE DO JOGADOR ======================== //
function findMyBase()
	local candidates = {
		workspace:FindFirstChild(Player.Name),
		workspace:FindFirstChild("Bases"),
		workspace:FindFirstChild("Base"),
	}
	for _, c in ipairs(candidates) do
		if c then
			if c.Name == Player.Name then
				local p = c:FindFirstChildWhichIsA("BasePart", true)
				if p then return p.Position end
			end
			local mine = c:FindFirstChild(Player.Name)
			if mine then
				local p = mine:FindFirstChildWhichIsA("BasePart", true)
				if p then return p.Position end
			end
		end
	end
	for _, obj in ipairs(workspace:GetDescendants()) do
		local n = obj.Name:lower()
		if obj:IsA("BasePart") and (n == "base" or n == "home" or n == "ninho" or n:find("deposit", 1, true)) then
			return obj.Position
		end
	end
	return nil
end

--// ================ MOVIMENTO ========================== //
function goToEgg(egg)
	local _, pos = eggScore(egg)
	if not pos then return end
	local root = getRoot()
	if not root then return end

	if State.Smooth then
		local dist = (root.Position - pos).Magnitude
		local duration = math.clamp(dist / math.max(State.Speed, 1), 0.05, 1.5)
		Tween(root, {CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))}, duration, Enum.EasingStyle.Linear)
	else
		root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
	end

	if STEAL_REMOTE then
		STEAL_REMOTE:FireServer(egg)
	end
end

function returnToBase()
	local basePos = findMyBase()
	if not basePos then
		notify("Não achei a sua base no mapa", Theme.Danger)
		return
	end
	local root = getRoot()
	if not root then return end

	if State.Smooth then
		local dist = (root.Position - basePos).Magnitude
		local duration = math.clamp(dist / math.max(State.Speed, 1), 0.1, 2)
		Tween(root, {CFrame = CFrame.new(basePos + Vector3.new(0, 3, 0))}, duration, Enum.EasingStyle.Linear)
	else
		root.CFrame = CFrame.new(basePos + Vector3.new(0, 3, 0))
	end
end

--// ============ AVISO DE VELOCIDADE SEGURA ============= //
local function checkSafeSpeed()
	if not State.SafeSpeed then return end
	local root = getRoot()
	if not root then return end
	local n = root.Position -- posição atual

	for key, need in pairs(BIOME_SPEED) do
		local zone = workspace:FindFirstChild(key, true)
		if zone and need then
			local part = zone:FindFirstChildWhichIsA("BasePart", true)
			if part and (part.Position - n).Magnitude < 400 then
				local humanoid = Player.Character and Player.Character:FindFirstChildWhichIsA("Humanoid")
				local mySpeed = humanoid and humanoid.WalkSpeed or 0
				if mySpeed > 0 and mySpeed < need then
					notify(("⚠ Velocidade %d < recomendada %d (%s)"):format(mySpeed, need, key), Theme.Warning)
				end
			end
		end
	end
end

--// ============ LOOP: AUTO ROUBO ======================= //
task.spawn(function()
	while true do
		if State.AutoSteal then
			local egg = findBestEgg()
			if egg then
				State.Target = egg
				targetInfo.Text = ("🎯 Alvo: %s  |  Score: %d"):format(egg.Name, State.LastScore)
				targetInfo.TextColor3 = Theme.Success

				checkSafeSpeed()
				goToEgg(egg)
				task.wait(0.25)

				local root = getRoot()
				local _, pos = eggScore(egg)
				if root and pos and (root.Position - pos).Magnitude < 12 then
					collectEgg(egg)          -- interação real no ovo
					task.wait(0.2)
					if State.AutoReturn then
						returnToBase()       -- leva o ovo pra base pra chocar
						task.wait(0.5)
					end
				end
			else
				targetInfo.Text = "Procurando ovos no modo atual..."
				targetInfo.TextColor3 = Theme.SubText
				task.wait(0.6)
			end
		else
			task.wait(0.4)
		end
	end
end)

--// ============ LOOP: AUTO COLETAR ===================== //
task.spawn(function()
	while true do
		if State.AutoCollect then
			local root = getRoot()
			if root then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if isEgg(obj) then
						local part = getEggPart(obj)
						if part and (part.Position - root.Position).Magnitude < 16 then
							collectEgg(obj)
							task.wait(0.2)
						end
					end
				end
			end
		end
		task.wait(0.35)
	end
end)

--// ============ LOOP: AUTO INTERAGIR =================== //
task.spawn(function()
	while true do
		if State.AutoInteract then
			local root = getRoot()
			if root then
				interactNearby(root.Position, 22)
			end
		end
		task.wait(0.5)
	end
end)

--// ============ LOOP: CRONÔMETRO DE OVOS =============== //
task.spawn(function()
	while true do
		task.wait(1)
		State.CycleLeft -= 1
		if State.CycleLeft <= 0 then
			State.CycleLeft = EGG_RESET_SECONDS
			notify("🥚 Ovos novos spawnaram no mapa!", Theme.Accent2)
		end
		local m = math.floor(State.CycleLeft / 60)
		local s = State.CycleLeft % 60
		timerLabel.Text = ("Ovos novos em %d:%02d"):format(m, s)
	end
end)


local function createToggle(parent, title, desc, default, order, callback)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 52)
	holder.BackgroundColor3 = Theme.Panel
	holder.BackgroundTransparency = 0.25
	holder.LayoutOrder = order
	holder.Parent = parent
	Round(holder, 12)
	Stroke(holder, Theme.Stroke, 0.75, 1)

	Label(holder, title, UDim2.new(1, -90, 0, 16), Theme.Text, true, UDim2.new(0, 14, 0, 10)).TextSize = 13
	Label(holder, desc, UDim2.new(1, -90, 0, 14), Theme.SubText, false, UDim2.new(0, 14, 0, 28)).TextSize = 11

	local switch = Instance.new("TextButton")
	switch.Size = UDim2.fromOffset(48, 26)
	switch.Position = UDim2.new(1, -62, 0.5, -13)
	switch.AutoButtonColor = false
	switch.Text = ""
	switch.BackgroundColor3 = Theme.PanelLight
	switch.Parent = holder
	Round(switch, 100)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(20, 20)
	knob.Position = UDim2.fromOffset(3, 3)
	knob.BackgroundColor3 = Theme.Text
	knob.Parent = switch
	Round(knob, 100)

	local on = default
	local function render(instant)
		local goalColor = on and Theme.Accent or Theme.PanelLight
		local goalPos = on and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
		if instant then
			switch.BackgroundColor3 = goalColor
			knob.Position = goalPos
		else
			Tween(switch, {BackgroundColor3 = goalColor}, 0.22)
			Tween(knob, {Position = goalPos}, 0.22, Enum.EasingStyle.Back)
		end
	end
	render(true)

	switch.MouseButton1Click:Connect(function()
		on = not on
		render(false)
		callback(on)
	end)

	holder.MouseEnter:Connect(function() Tween(holder, {BackgroundTransparency = 0.1}, 0.15) end)
	holder.MouseLeave:Connect(function() Tween(holder, {BackgroundTransparency = 0.25}, 0.15) end)
	return holder
end

local function createSlider(parent, title, min, max, default, order, callback)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 58)
	holder.BackgroundColor3 = Theme.Panel
	holder.BackgroundTransparency = 0.25
	holder.LayoutOrder = order
	holder.Parent = parent
	Round(holder, 12)
	Stroke(holder, Theme.Stroke, 0.75, 1)

	local valueLabel = Label(holder, tostring(default), UDim2.fromOffset(60, 16), Theme.Accent2, true, UDim2.new(1, -70, 0, 10))
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	Label(holder, title, UDim2.new(1, -90, 0, 16), Theme.Text, true, UDim2.new(0, 14, 0, 10)).TextSize = 13

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, -28, 0, 6)
	bar.Position = UDim2.new(0, 14, 1, -20)
	bar.BackgroundColor3 = Theme.PanelLight
	bar.Parent = holder
	Round(bar, 100)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale((default - min) / (max - min), 1)
	fill.BackgroundColor3 = Theme.Accent
	fill.Parent = bar
	Round(fill, 100)
	Gradient(fill, Theme.Accent, Theme.Accent2, 0)

	local drag = Instance.new("TextButton")
	drag.Size = UDim2.fromOffset(16, 16)
	drag.Position = UDim2.new(fill.Size.X.Scale, -8, 0.5, -8)
	drag.BackgroundColor3 = Theme.Text
	drag.Text = ""
	drag.AutoButtonColor = false
	drag.Parent = bar
	Round(drag, 100)

	local dragging = false
	local function update(input)
		local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local val = math.floor(min + (max - min) * rel + 0.5)
		fill.Size = UDim2.fromScale(rel, 1)
		drag.Position = UDim2.new(rel, -8, 0.5, -8)
		valueLabel.Text = tostring(val)
		callback(val)
	end

	drag.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return holder
end

local function createButton(parent, text, color, order, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 42)
	btn.BackgroundColor3 = color or Theme.Accent
	btn.AutoButtonColor = false
	btn.Font = Enum.Font.GothamBold
	btn.Text = text
	btn.TextColor3 = Theme.Text
	btn.TextSize = 13
	btn.LayoutOrder = order
	btn.Parent = parent
	Round(btn, 12)
	Gradient(btn, color or Theme.Accent, Theme.Accent2, 20)

	btn.MouseEnter:Connect(function() Tween(btn, {BackgroundTransparency = 0.15}, 0.15) end)
	btn.MouseLeave:Connect(function() Tween(btn, {BackgroundTransparency = 0}, 0.15) end)
	btn.MouseButton1Down:Connect(function() Tween(btn, {Size = UDim2.new(1, -6, 0, 39)}, 0.1) end)
	btn.MouseButton1Up:Connect(function()
		Tween(btn, {Size = UDim2.new(1, 0, 0, 42)}, 0.15, Enum.EasingStyle.Back)
		callback()
	end)
	return btn
end

-- seletor segmentado (modos de mira)
local function createSegment(parent, options, defaultKey, order, callback)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 40)
	holder.BackgroundTransparency = 1
	holder.LayoutOrder = order
	holder.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 8)
	layout.Parent = holder

	local buttons = {}
	for _, opt in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1 / #options, -6, 1, 0)
		b.BackgroundColor3 = Theme.Panel
		b.BackgroundTransparency = 0.25
		b.AutoButtonColor = false
		b.Font = Enum.Font.GothamSemibold
		b.Text = opt[2]
		b.TextSize = 11
		b.TextColor3 = Theme.SubText
		b.Parent = holder
		Round(b, 10)
		Stroke(b, Theme.Stroke, 0.7, 1)
		buttons[opt[1]] = b

		b.MouseButton1Click:Connect(function()
			for k, other in pairs(buttons) do
				local active = (k == opt[1])
				Tween(other, {
					TextColor3 = active and Theme.Text or Theme.SubText,
					BackgroundTransparency = active and 0 or 0.25,
				}, 0.18)
				Stroke(other, active and Theme.Accent or Theme.Stroke, active and 0 or 0.7, 1)
			end
			callback(opt[1])
		end)
	end

	local b0 = buttons[defaultKey]
	if b0 then
		b0.TextColor3 = Theme.Text
		b0.BackgroundTransparency = 0
		Stroke(b0, Theme.Accent, 0, 1)
	end
	return holder
end


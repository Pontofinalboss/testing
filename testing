--// ============ DADOS: CACHE (leve) =================== //
local EGG_FOLDERS = {
	workspace:FindFirstChild("Ovos") or workspace:FindFirstChild("Eggs"),
}

local BLACKLIST = {
	"fusao","fusion","maquina","machine","máquina","loja","shop","npc",
	"vendedor","vendor","hatch","incubat","chocar","portal","teleport",
	"altar","base","spawnpoint","botao","button","placa","sign",
	"shrine","sacrifice","rift","index","checklist",
}

local MAX_EGG_SIZE = 14
local PICKUP_REMOTE = nil -- ex: game.ReplicatedStorage.Events.CollectEgg
local STEAL_REMOTE  = nil -- ex: game.ReplicatedStorage.Events.StealEgg

local EggCache   = {} -- {obj, part, name, area, score, rarity}
local PromptCache= {} -- {prompt, part}
local BiomeCache = {} -- {pos, need, name}

local function nameBlacklisted(name)
	for _, bad in ipairs(BLACKLIST) do
		if name:find(bad, 1, true) then return true end
	end
	return false
end

local function getEggPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function isInEggFolder(obj)
	for _, folder in ipairs(EGG_FOLDERS) do
		if folder and obj:IsDescendantOf(folder) then return true end
	end
	return false
end

local function hasEggWord(n)
	return (n:find("egg", 1, true) or n:find("ovo", 1, true)) and true or false
end

local function isEgg(obj)
	if not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
	local n = obj.Name:lower()
	if not hasEggWord(n) then return false end
	if nameBlacklisted(n) then return false end
	local part = getEggPart(obj)
	if not part then return false end
	if part.Size.Magnitude > MAX_EGG_SIZE then return false end
	local hasPrompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
	local hasTouch  = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
	return isInEggFolder(obj) or hasPrompt or hasTouch
end

local function matchesMode(obj, mode)
	if mode == "best" or mode == "all" then return true end
	local n = obj.Name:lower()
	if mode == "sakura" then
		return (n:find("sakura", 1, true) or n:find("cherry", 1, true)) and hasEggWord(n)
	end
	if mode == "angels" then
		local key = n:find("angel", 1, true) or n:find("anjo", 1, true)
			or n:find("demon", 1, true) or n:find("demônio", 1, true)
			or n:find("demonio", 1, true) or n:find("light", 1, true)
			or n:find("dark", 1, true)
		return key and hasEggWord(n)
	end
	return true
end

local function eggScore(inst)
	local part = getEggPart(inst)
	if not part then return nil end

	local value
	for _, key in ipairs({"Value","EggValue","Price","Coins","Money","DayValue","Income","Reward"}) do
		local v = inst:GetAttribute(key)
		if typeof(v) == "number" then value = v break end
	end

	local rarity = 0
	local r = inst:GetAttribute("Rarity") or inst:GetAttribute("Tier")
	if typeof(r) == "number" then
		rarity = r
	elseif typeof(r) == "string" then
		rarity = RARITY[r:lower()] or 0
	end
	if rarity == 0 then
		local n = inst.Name:lower()
		for key, val in pairs(RARITY) do
			if n:find(key, 1, true) then rarity = val break end
		end
	end

	return (value or 0) * 10 + rarity * 1000, part.Position, rarity
end

local function areaOf(obj)
	local p = obj.Parent
	if not p or p == workspace then return "Mapa" end
	local n = p.Name:lower()
	if n:find("ovo",1,true) or n:find("egg",1,true) or n:find("spawn",1,true) then
		local gp = p.Parent
		if gp and gp ~= workspace then return gp.Name end
	end
	return p.Name
end

local function tryAddEgg(d)
	if not isEgg(d) then return end
	local part = getEggPart(d)
	if not part then return end
	local score, _, rarity = eggScore(d)
	table.insert(EggCache, {
		obj = d, part = part, name = d.Name,
		area = areaOf(d), score = score or 0, rarity = rarity or 0,
	})
end

local function scanAll()
	table.clear(EggCache)
	table.clear(PromptCache)
	table.clear(BiomeCache)
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local part = d.Parent
			if part and not part:IsA("BasePart") then part = part:FindFirstChildWhichIsA("BasePart", true) end
			table.insert(PromptCache, {prompt = d, part = part})
		else
			tryAddEgg(d)
		end
	end
	for _, c in ipairs(workspace:GetChildren()) do
		local need = BIOME_SPEED[c.Name:lower()]
		if need then
			local part = c:IsA("BasePart") and c or c:FindFirstChildWhichIsA("BasePart", true)
			if part then table.insert(BiomeCache, {pos = part.Position, need = need, name = c.Name}) end
		end
	end
end

-- eventos: mantém o cache atualizado sem varrer o mapa
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("ProximityPrompt") then
		local part = d.Parent
		if part and not part:IsA("BasePart") then part = part:FindFirstChildWhichIsA("BasePart", true) end
		table.insert(PromptCache, {prompt = d, part = part})
	else
		tryAddEgg(d)
	end
end)

workspace.DescendantRemoving:Connect(function(d)

local function notify(text, color)
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromOffset(280, 38)
	t.BackgroundColor3 = Theme.Panel
	t.BackgroundTransparency = 0.1
	t.Font = Enum.Font.GothamSemibold
	t.Text = text
	t.TextColor3 = color or Theme.Text
	t.TextSize = 12
	t.Parent = toastHolder
	Round(t, 12)
	Stroke(t, color or Theme.Accent, 0.4, 1)
	t.TextTransparency = 1
	t.BackgroundTransparency = 1

	Tween(t, {TextTransparency = 0, BackgroundTransparency = 0.1}, 0.25)
	task.delay(2.2, function()
		Tween(t, {TextTransparency = 1, BackgroundTransparency = 1}, 0.35)
		task.wait(0.4)
		t:Destroy()
	end)
end


--// ============ LOOP PRINCIPAL (só 1) ================= //
task.spawn(function()
	local lastScan = os.clock()
	local lastSafe = os.clock()

	while true do
		task.wait(0.25)

		-- scan completo só a cada 5s (barato)
		if os.clock() - lastScan > 5 then
			lastScan = os.clock()
			scanAll()
		end

		-- AUTO ROUBO: voa, espera chegar, interage e volta
		if State.AutoSteal and not flying then
			local rec = findBestEgg()
			if rec then
				State.Target = rec
				targetInfo.Text = ("🎯 Alvo: %s | Score: %d"):format(rec.name, rec.score)
				targetInfo.TextColor3 = Theme.Success
				if STEAL_REMOTE then pcall(function() STEAL_REMOTE:FireServer(rec.obj) end) end
				flyTo(rec.part.Position + Vector3.new(0, 3, 0), State.Speed, function()
					collectEgg(rec.obj)          -- interage de verdade
					if State.AutoReturn then
						task.wait(0.35)
						returnToBase()           -- leva pra base
					end
				end)
			else
				targetInfo.Text = "Procurando ovos no modo atual..."
				targetInfo.TextColor3 = Theme.SubText
			end
		end

		-- AUTO COLETAR (o que já funciona): só ovos do cache
		if State.AutoCollect then
			local root = getRoot()
			if root then
				for _, rec in ipairs(EggCache) do
					if rec.obj.Parent and (rec.part.Position - root.Position).Magnitude < 16 then
						collectEgg(rec.obj)
						break -- um por tick = leve
					end
				end
			end
		end

		-- AUTO INTERAGIR: prompts do cache
		if State.AutoInteract then
			local root = getRoot()
			if root then interactNearby(root.Position, 22) end
		end

		-- AVISO DE VELOCIDADE (a cada 5s, contra cache)
		if State.SafeSpeed and os.clock() - lastSafe > 5 then
			lastSafe = os.clock()
			local root = getRoot()
			if root then
				for _, b in ipairs(BiomeCache) do
					if (b.pos - root.Position).Magnitude < 400 then
						local hum = Player.Character and Player.Character:FindFirstChildWhichIsA("Humanoid")
						local my = hum and hum.WalkSpeed or 0
						if my > 0 and my < b.need then
							notify(("⚠ Velocidade %d < %d (%s)"):format(my, b.need, b.name), Theme.Warning)
						end
					end
				end
			end
		end
	end
end)


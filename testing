--// ============ INSTANT INTERACT ====================== //
firePrompt = function(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	pcall(function()
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 250)
		prompt.RequiresLineOfSight = false
		local oldHold = prompt.HoldDuration
		if State.InstantInt then prompt.HoldDuration = 0 end
		prompt:InputHoldBegin()
		task.wait(State.InstantInt and 0.02 or math.max(oldHold, 0.05))
		prompt:InputHoldEnd()
		prompt.HoldDuration = oldHold
	end)
	return true
end

interactNearby = function(pos, radius)
	local n = 0
	for _, rec in ipairs(PromptCache) do
		local part = rec.part
		if part and part.Parent and (part.Position - pos).Magnitude <= radius then
			if firePrompt(rec.prompt) then n += 1 end
		end
	end
	return n
end

--// ============ COLETA ================================= //
getRoot = function()
	local char = Player.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

collectEgg = function(obj)
	if PICKUP_REMOTE then
		PICKUP_REMOTE:FireServer(obj)
		return true
	end
	local n = 0
	if obj:IsA("ProximityPrompt") then firePrompt(obj) n += 1 end
	for _, d in ipairs(obj:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			firePrompt(d)
			n += 1
		end
	end
	if n == 0 then
		local part = getEggPart(obj)
		local root = getRoot()
		if part and root then
			root.CFrame = CFrame.new(part.Position + Vector3.new(0, (part.Size.Y / 2) + 2.5, 0))
			task.wait(0.25)
			return true
		end
	end
	return n > 0
end

--// ============ MOTOR DE VOO (leve e confiável) ======== //
local flying = false

local function flyTo(pos, speed, onArrive)
	if flying then return false end
	local root = getRoot()
	if not root then return false end
	flying = true

	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not flying or not root.Parent then
			flying = false
			conn:Disconnect()
			return
		end
		local delta = pos - root.Position
		local dist = delta.Magnitude
		if dist < 5 then
			flying = false
			conn:Disconnect()
			if onArrive then task.spawn(onArrive) end
			return
		end
		local step = math.min(dist, (speed or 120) * dt)
		root.CFrame = CFrame.new(root.Position + delta.Unit * step)
		pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
	end)
	return true
end

flyToEgg = function(rec)
	if not rec or not rec.part then return end
	State.Target = rec
	targetInfo.Text = ("🎯 Alvo: %s | Score: %d"):format(rec.name, rec.score)
	targetInfo.TextColor3 = Theme.Success
	if STEAL_REMOTE then pcall(function() STEAL_REMOTE:FireServer(rec.obj) end) end
	return flyTo(rec.part.Position + Vector3.new(0, 3, 0), State.Speed)
end

returnToBase = function()
	local pos = findMyBase()
	if not pos then
		notify("Não achei a sua base no mapa", Theme.Danger)
		return
	end
	flyTo(pos + Vector3.new(0, 3, 0), State.Speed)
	notify("Voltando para a base", Theme.Accent2)
end

--// ============ MELHOR OVO ============================ //
findBestEgg = function()
	local mode = State.Mode
	local root = getRoot()
	local best, bestScore = nil, -math.huge
	for _, rec in ipairs(EggCache) do
		if rec.obj.Parent and matchesMode(rec.obj, mode) then
			local fs
			if mode == "all" then
				fs = root and -(rec.part.Position - root.Position).Magnitude or 0
			else
				fs = rec.score
			end
			if fs > bestScore then
				best, bestScore = rec, fs
			end
		end
	end
	State.LastScore = best and best.score or 0
	return best
end


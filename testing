local basePosCache = nil

local function findMyBase()
	if basePosCache then return basePosCache end
	local byName = workspace:FindFirstChild(Player.Name)
	if byName then
		local p = byName:FindFirstChildWhichIsA("BasePart", true)
		if p then basePosCache = p.Position return basePosCache end
